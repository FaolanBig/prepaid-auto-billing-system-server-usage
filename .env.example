# Replace every replace-me value before starting the stack.
POSTGRES_DB=powerbilling
POSTGRES_USER=powerbilling
POSTGRES_PASSWORD=replace-me-postgres-password

INFLUXDB_USERNAME=powerbilling
INFLUXDB_PASSWORD=replace-me-influx-password
INFLUX_ORG=powerbilling
INFLUX_BUCKET=power
INFLUX_TOKEN=replace-me-influx-token

# Local Shelly Plug M Gen3 RPC endpoint, reachable from server1.
SHELLY_URL=http://192.168.1.123/rpc/Switch.GetStatus?id=0
SHELLY_USERNAME=
SHELLY_PASSWORD=
SHELLY_POLL_SECONDS=60

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me-with-a-unique-secret-of-at-least-16-characters
COOKIE_SECRET=replace-me-with-at-least-32-random-bytes
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com

# SMTP submission server; STARTTLS is required when sending notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=power-billing@example.com

# The admin panel is bound to loopback by default. Change only when needed.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
